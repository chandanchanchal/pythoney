CREATE FUNCTION security_lab1.raw.mask_ssn(ssn STRING)
RETURN
  CASE
    WHEN is_member(' account admins') THEN ssn
    ELSE 'XXX-XX-XXXX'
  END;

ALTER TABLE security_lab1.raw.employees
ALTER COLUMN ssn
SET MAsk security_lab1.raw.mask_ssn;

-- ROW Filtering
CREATE FUNCTION security_lab1.raw.department_filter(dept STRING)
RETURN dept = current_user();

ALTER TABLE security_lab1.raw.employees
SET ROW FILTER security_lab1.raw.department_filter on (department);
